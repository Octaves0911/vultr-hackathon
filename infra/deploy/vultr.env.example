# Copy to .env.prod in the repository root on the server, then fill it in. Never commit it.
# Generate the secrets with: infra/deploy/gen-secrets.sh        (all other names: infra/deploy/env.production.example)

DOMAIN=meet.example.com               # the hostname that points at this server (A record); Caddy gets a certificate for it
WEB_URL=https://meet.example.com
POSTGRES_PASSWORD=                    # any long random string; the app connects to the bundled Postgres with it

INTERNAL_SECRET=
TOKEN_ENC_KEY=
# Vultr Serverless Inference (OpenAI-compatible). Base URL is built in: https://api.vultrinference.com/v1/chat/completions
LLM_API_KEY=                          # your Vultr Inference key
LLM_MODEL=                            # REQUIRED: a model id from `curl https://api.vultrinference.com/v1/models -H "Authorization: Bearer $LLM_API_KEY"`
# AGENT_MODEL_RESEARCH=               # [optional] a stronger model for research / code
# AGENT_MODEL_CODE=
# LLM_PRICE_IN_PER_M=0                # USD per 1M input / output tokens from Vultr's price list, so the cost shown and AGENT_DAILY_CAP_USD work
# LLM_PRICE_OUT_PER_M=0
# Web search (Research agent) needs the Responses API, which Vultr does not offer: Research falls back to project-only sources.
# To use Meta instead: LLM_API_URL=https://api.meta.ai/v1/chat/completions and LLM_MODEL=muse-spark-1.3
AGENT_DAILY_CAP_USD=1
MEETING_TZ=Asia/Kolkata
EMBEDDING_PROVIDER=fake

STT_MODE=stream
DEEPGRAM_API_KEY=

# Gmail / Drive (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://meet.example.com/api/connections/google/callback

# Video relay (optional; start it with --profile turn)
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=turn:meet.example.com:3478
TURN_USERNAME=
TURN_CREDENTIAL=

# Code verification (optional)
SANDBOX_MODE=off
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

SEED_DEMO=1                           # loads a demo project on the first start; set to 0 afterwards
SEED_DEMO_USER=aman
