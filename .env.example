# MeetPilot local settings. Copy to .env (cp .env.example .env) and fill in. Never commit .env.
# Restart ./infra/start.sh after every change.

# ---- core (works as is) ----------------------------------------------------------------------------------------------
DATABASE_URL=postgres://meetpilot:meetpilot@localhost:5432/meetpilot
INTERNAL_SECRET=                      # 24+ random chars:  openssl rand -hex 24
TOKEN_ENC_KEY=                        # encrypts saved Google/GitHub tokens:  openssl rand -base64 32  (keep it stable)
WEB_URL=http://localhost:5173
MEETING_TZ=Asia/Kolkata               # resolves spoken dates like "Friday"

# ---- LLM: Vultr Serverless Inference (assistant, @ai, extractor, judge, all agents, review chat) ---------------------
LLM_API_KEY=
LLM_MODEL=

# AGENT_MODEL_RESEARCH=               # optional: stronger model for research / code
# AGENT_MODEL_CODE=
# ROUTER_MODEL=                       # optional: model for task routing
LLM_PRICE_IN_PER_M=0                  # USD per 1M input tokens (Vultr price list): makes cost display and the spend cap work
LLM_PRICE_OUT_PER_M=0                 # USD per 1M output tokens
AGENT_DAILY_CAP_USD=5                 # spend cap per project per day
# AGENTS_MODE=mock                    # leave unset for real agents (mock = canned outputs, no LLM)
# LLM_API_URL=                        # default is Vultr; set only to switch provider (Meta: https://api.meta.ai/v1/chat/completions)

# ---- embeddings (project memory search) -------------------------------------------------------------------------------
EMBEDDING_PROVIDER=fake               # fake = offline word-overlap. real = needs the next three lines
# EMBEDDING_API_KEY=                  # Vultr key (or OpenAI) ; the model MUST return 1536-d vectors
# EMBEDDING_API_URL=https://api.vultrinference.com/v1/embeddings
# EMBEDDING_MODEL=                    # an embedding model id from /v1/models
# After switching to real, use a fresh DB (npm run db:reset -w @meetpilot/backend) so old vectors are not mixed in.

# ---- live captions (Deepgram) -----------------------------------------------------------------------------------------
STT_MODE=stream                       # stream = real mic captions | mock = fake captions | off
DEEPGRAM_API_KEY=                     # https://console.deepgram.com (free credit is enough)

# ---- Gmail and Drive (Google OAuth) -------------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=                     # Google Cloud: OAuth client type "Web application", enable Gmail + Drive APIs
GOOGLE_CLIENT_SECRET=                 # redirect URI to register: http://localhost:5173/api/connections/google/callback
                                      # add your Google account as a Test user on the consent screen

# ---- Code agent / GitHub ----------------------------------------------------------------------------------------------
GITHUB_TOKEN=                         # personal access token (repo scope) to read repos / open PRs; optional if users connect GitHub in the app
SANDBOX_MODE=off                      # off | modal ; modal runs generated code in a Modal sandbox for verification
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# ---- workspace files (optional) ---------------------------------------------------------------------------------------
# WORKSPACE_LOCAL_BASE=/absolute/path/to/parent/folder   # lets a project owner link a sub-folder as workspace

# ---- video calls across strict networks (optional; not needed on localhost) --------------------------------------------
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=
# TURN_USERNAME=
# TURN_CREDENTIAL=
